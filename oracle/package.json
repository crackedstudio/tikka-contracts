{
  "name": "oracle-service",
  "version": "1.0.0",
  "description": "Off-chain oracle service for Tikka Contracts",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "test": "jest",
    "test:ci": "jest --ci --coverage --runInBand",
    "format": "prettier --write \"src/**/*.{ts,md}\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,md}\" \"*.md\"",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.6.1",
    "dotenv": "^16.4.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "nock": "^13.5.4",
    "prettier": "^3.9.6",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.8.0"
  }
}
