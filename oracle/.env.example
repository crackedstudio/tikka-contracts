# Oracle Service — Environment Variables
# Copy this file to .env and fill in the required values.
# Never commit .env or any file containing real secret keys.
#
# Full reference: docs/env/README.md

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Oracle signing key. Accepts a Stellar S… secret, 32-byte hex, or base64 seed.
ORACLE_SECRET_KEY="S..."

# Soroban RPC endpoint.
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"

# Factory contract ID (C…) the oracle event listener subscribes to.
FACTORY_CONTRACT_ID=""

# ---------------------------------------------------------------------------
# Optional — service behaviour
# ---------------------------------------------------------------------------

# Oracle public key (G…). Required by the event listener to filter events
# for this oracle instance.
ORACLE_ADDRESS=""

# Network passphrase for transaction signing.
# Defaults to the Stellar testnet passphrase if unset.
# STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Event polling interval in milliseconds (default: 5000).
POLL_INTERVAL_MS="5000"

# Backward-compatible alias for POLL_INTERVAL_MS; POLL_INTERVAL_MS takes
# precedence when both are set.
# ORACLE_POLL_INTERVAL_MS="5000"

# Log verbosity: debug | info | warn | error (default: info).
LOG_LEVEL="info"

# Path to the ledger checkpoint file used for restart recovery.
ORACLE_CHECKPOINT_PATH=".oracle-checkpoint.json"

# ---------------------------------------------------------------------------
# Integration tests only (STELLAR_INTEGRATION_TEST=1)
# ---------------------------------------------------------------------------

# Set to 1 to run integration tests against a live testnet.
# STELLAR_INTEGRATION_TEST="1"

# Deployed raffle instance contract ID for integration tests.
# RAFFLE_CONTRACT_ADDRESS=""

# Pending randomness request ID to fulfill in the integration test.
# RANDOMNESS_REQUEST_ID=""

# Seed value for provide_randomness in the integration test (default: 42).
# RANDOMNESS_SEED="42"
