# Deployment

# Used by scripts/invoke.sh and scripts/verify.sh to select the Stellar network
STELLAR_NETWORK="testnet"
# Used by oracle/src/config.ts, event-listener, tx-submitter, and docker-compose for Soroban RPC
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
# Used by scripts/deploy-testnet.sh, scripts/deploy-mainnet.sh, and scripts/invoke.sh to sign transactions
DEPLOYER_SECRET_KEY=
# Used by scripts/invoke.sh and scripts/verify.sh to identify the target raffle contract
RAFFLE_CONTRACT_ADDRESS=
# Set to 1 to let a deploy script replace an address already recorded in deployments/
ALLOW_REDEPLOY=

# Oracle

# Used by oracle/src/config.ts and docker-compose to identify the factory contract the oracle listens on
FACTORY_CONTRACT_ID=
# Used by oracle/src/config.ts and KeyService to sign provide_randomness transactions
ORACLE_SECRET_KEY=
# Used by oracle/src/config.ts as the primary event poll interval (milliseconds)
POLL_INTERVAL_MS="5000"
# Used by oracle/src/config.ts as a fallback poll interval and by event-listener.service.ts
ORACLE_POLL_INTERVAL_MS="5000"
# Used by oracle/src/config.ts and docker-compose for log verbosity
LOG_LEVEL="info"

# Admin

# Required by scripts/deploy-*.sh — the admin passed to init_factory
ADMIN_ADDRESS=
# Treasury passed to init_factory; defaults to ADMIN_ADDRESS when unset
TREASURY_ADDRESS=
# Protocol fee in basis points passed to init_factory (250 = 2.5%); defaults to 0
PROTOCOL_FEE_BP=

# Oracle Alerting (optional) — generic JSON POST webhook (Slack/Discord/PagerDuty)
ALERT_WEBHOOK_URL=""            # If empty, operational alerts are disabled
ALERT_FAILURE_THRESHOLD="3"     # Consecutive tx-submission failures before alerting
ALERT_RATE_LIMIT_MS="60000"     # Min interval between alerts of the same type
ALERT_QUEUE_DEPTH_LIMIT="10"    # Queue depth that triggers a warning
ALERT_QUEUE_AGE_LIMIT_MS="300000" # Max age of the oldest queued request
ALERT_RPC_UNREACHABLE_THRESHOLD="3" # Consecutive RPC poll failures before alerting
QUEUE_MAX_ATTEMPTS="5"            # Retries before a randomness job is dead-lettered
HEALTH_PORT="3000"                # HTTP port for /health readiness (queue + dead-letter depth)
